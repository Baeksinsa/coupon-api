[Unit]
Description=Coupon API (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/coupon-api
EnvironmentFile=/etc/coupon-api.env
ExecStart=/opt/coupon-api/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
