# /etc/coupon-api.env 로 복사해서 사용 (권한 600, root 소유)
# 서버 A와 완전히 동일한 값을 넣어야 두 서버가 같은 DB/캐시를 바라본다.

DB_HOST=coupon-db-xxx.xxxxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=coupon
DB_USER=coupon
# Secrets Manager에서 비밀번호를 읽는다. 이 ARN을 읽을 수 있는 IAM 역할이 인스턴스에 붙어 있어야 한다.
DB_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:000000000000:secret:rds!db-xxxxxxxx
DB_SSLMODE=require
AWS_REGION=ap-northeast-2

REDIS_URL=rediss://master.coupon-cache-xxx.xxxxxx.apn2.cache.amazonaws.com:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=5

# 선택값 (미지정 시 코드 기본값 사용)
# DB_PASSWORD=          # DB_SECRET_ARN을 안 쓸 때만
# DB_POOL_SIZE=10
